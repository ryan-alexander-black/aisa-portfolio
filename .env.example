# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Resend API key (resend.com → API Keys). Required for the /operator-form route to send.
RESEND_API_KEY=

# Where intake submissions are emailed. Once ryanalexanderblack.com is verified in
# Resend you can set this to your Gmail directly. Defaults to ryanalexanderblack@gmail.com.
OPERATOR_FORM_TO=

# --- The free AI report (/ai-report) ---
# Claude writes the report. Use a key made for the site, with a monthly spend limit set on its
# Anthropic workspace (the hard stop on spend; the in-app rate limit is best effort only).
ANTHROPIC_API_KEY=
# Firecrawl reads the visitor's website (firecrawl.dev → API keys).
FIRECRAWL_API_KEY=
# Signs the site read between the two steps. Any random string of 32+ characters.
MINI_REPORT_SECRET=

# --- Tracking (each tag loads only when its ID is set) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_REPORT=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_APPLY=

# Optional: override the send-from identity. Must be on a domain verified in Resend.
# Defaults to: Ryan Alexander Black — Operator Intake <hello@ryanalexanderblack.com>
MAIL_FROM=
